{
  "name": "nodejs",
  "version": "0.2.1",
  "detect": ["package.json"],
  "standards_skill": "aisdlc-nodejs:standards",
  "quality_gate": {
    "linter": "eslint",
    "test_runner": "jest",
    "coverage_thresholds": {
      "branches": 80,
      "functions": 80,
      "lines": 80,
      "statements": 80
    }
  },
  "hooks": {
    "before_task": null,
    "after_task": {
      "run": [
        "npm run lint",
        "npm run test:coverage"
      ]
    }
  }
}
