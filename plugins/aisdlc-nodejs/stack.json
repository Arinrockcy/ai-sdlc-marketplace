{
  "name": "nodejs",
  "version": "0.7.0",
  "detect": ["package.json"],
  "standards_skill": "aisdlc-nodejs:standards",
  "runtime": {
    "node": ">=24",
    "module_type": "module"
  },
  "quality_gate": {
    "linter": "eslint",
    "test_runner": "jest",
    "coverage_report": {
      "path": "coverage/coverage-summary.json",
      "format": "json-summary"
    },
    "coverage_thresholds": {
      "branches": 80,
      "functions": 80,
      "lines": 80,
      "statements": 80
    }
  },
  "hooks": {
    "before_task": null,
    "after_task": {
      "run": [
        "npm run lint",
        "npm run test:coverage"
      ]
    }
  }
}
